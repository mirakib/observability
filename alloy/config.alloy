
logging {
  level  = "info"
  format = "logfmt"
}

// Discover Kubernetes Pods using your kubeconfig
discovery.kubernetes "pods" {
  role            = "pod"
  kubeconfig_file = "/etc/alloy/kubeconfig"
}

discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    action        = "replace"
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    action        = "replace"
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    action        = "replace"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    action        = "replace"
    target_label  = "app"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
    separator     = "/"
    action        = "replace"
    target_label  = "job"
  }
}

// Collect Kubernetes Pod logs and send them to Loki
loki.source.kubernetes "pods" {
  targets = discovery.relabel.pod_logs.output

  client {
    kubeconfig_file = "/etc/alloy/kubeconfig"
  }

  forward_to = [
    loki.write.kubernetes.receiver,
  ]
}

// Send Kubernetes logs to Loki
loki.write "kubernetes" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Scrape kube-state-metrics
prometheus.scrape "kube_state_metrics" {
  targets = [
    {
      "__address__" = "host.docker.internal:8081",
      "job"         = "kube-state-metrics",
    },
  ]

  scrape_interval = "15s"
  scrape_timeout  = "10s"

  forward_to = [
    prometheus.remote_write.local.receiver,
  ]
}

// Forward metrics to Prometheus
prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
